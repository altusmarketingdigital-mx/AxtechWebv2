generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Quote {
  id        String   @id @default(cuid())
  name      String
  email     String
  service   String
  message   String
  createdAt DateTime @default(now())
}

model ServiceOrder {
  id          String   @id @default(cuid())
  technician  String
  clientName  String
  serviceType String
  serviceDate String
  report      String
  createdAt   DateTime @default(now())
}
